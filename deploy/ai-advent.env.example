# AI Advent Challenge — серверные переменные окружения.
# Скопируй в /etc/ai-advent.env (root:root, 0600) и заполни секреты.
# Значения в git не коммитить.

# LLM
DEEPSEEK_API_KEY=
HUGGING_FACE_TOKEN=
DEEPSEEK_MODEL=deepseek-flash

# Общие данные приложения и demo-MCP (каталог, внутри agent.sqlite)
AGENT_DB_PATH=/var/lib/ai-advent

# Второй MCP-сервер: собственная база (файл, 0600)
JOBS_DB_PATH=/var/lib/ai-advent/jobs.sqlite

# Явные entrypoint'ы MCP. Переопределяют резолв dist/cwd и гарантируют,
# что в проде спавнятся скомпилированные .mjs, а не dev-исходники.
AGENT_MCP_DEMO_ENTRY=/opt/ai-advent-challenge/dist/server/mcp/mcp-demo.mjs
AGENT_MCP_JOBS_ENTRY=/opt/ai-advent-challenge/dist/server/mcp/mcp-jobs.mjs
