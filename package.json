{
  "name": "ai-advent-challenge",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && npm run build:mcp",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:bot": "node scripts/build-bot.mjs",
    "bot": "npm run build:bot && node --env-file-if-exists=.env dist/server/bot/telegram-quiz.mjs",
    "build:llm-service": "node scripts/build-llm-service.mjs",
    "llm-service": "npm run build:llm-service && node --env-file-if-exists=.env dist/server/llm-service/llm-service.mjs",
    "llm-service:load": "node scripts/llm-service-load.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "review:pr": "node --env-file-if-exists=.env --import ./scripts/mcp-alias-loader.mjs src/features/dev-assistant/cli/review.ts",
    "file-assistant": "node --env-file-if-exists=.env --import ./scripts/mcp-alias-loader.mjs src/features/dev-assistant/cli/file-assistant.ts",
    "auto-review": "node --env-file-if-exists=.env --import ./scripts/mcp-alias-loader.mjs src/features/auto-review/cli/auto-review.ts",
    "playwright:install": "playwright install chromium firefox",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "clsx": "^2.1.1",
    "gpt-tokenizer": "^4.0.0",
    "grammy": "^1.46.0",
    "lucide-react": "^1.46.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
