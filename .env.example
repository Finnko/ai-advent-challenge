DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-flash
HUGGING_FACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Необязательно: путь к файлу БД агента (по умолчанию ~/.ai-advent-challenge/agent.sqlite)
AGENT_DB_PATH=
# Необязательно: папка отчётов research-MCP (по умолчанию ~/.ai-advent-challenge/reports)
REPORTS_DIR=
# Необязательно: RAG-эмбеддер (Day 21). Провайдер local — ONNX-модель на CPU без сети после загрузки.
RAG_EMBED_PROVIDER=local
RAG_EMBED_MODEL=Xenova/multilingual-e5-base
RAG_EMBED_DTYPE=q8
# Необязательно: реранкер второго этапа (Day 23). Локальный ONNX cross-encoder.
RAG_RERANK_MODEL=Xenova/bge-reranker-base
RAG_RERANK_DTYPE=q8
# Необязательно: порог отсечения нерелевантных результатов (0..1)
RAG_RERANK_THRESHOLD=0.5
# Необязательно: порог косинуса для режима «не знаю» в RAG-пайплайнах без реранка (0..1)
RAG_COSINE_THRESHOLD=0.35
# Необязательно: путь к БД индекса (по умолчанию ~/.ai-advent-challenge/rag.sqlite)
RAG_DB_PATH=
# Необязательно: папка кеша статей Википедии (по умолчанию ~/.ai-advent-challenge/rag-corpus)
RAG_CORPUS_DIR=
# Необязательно: контакт в User-Agent для MediaWiki API (по умолчанию URL репозитория проекта)
RAG_WIKI_CONTACT=
# Необязательно: локальная LLM на MLX (Day 26). OpenAI-совместимый эндпоинт mlx_lm.server.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=mlx-community/Qwen3-8B-4bit
# Необязательно: модель именно для Telegram-квиза (Day 27). По умолчанию LOCAL_LLM_MODEL.
# mlx_lm.server должен быть запущен с этой же моделью.
QUIZ_LLM_MODEL=mlx-community/Qwen3-14B-4bit
# Необязательно: модель локальной генерации RAG-ответов (Day 28). По умолчанию 14B.
# mlx_lm.server должен быть запущен с этой же моделью.
RAG_LLM_MODEL=mlx-community/Qwen3-14B-4bit
# Обязательно для Telegram-квиза (Day 27). Токен от @BotFather.
TELEGRAM_BOT_TOKEN=
# Необязательно: список Telegram user id через запятую. Пусто — бот открыт для всех (dev).
TELEGRAM_ALLOWED_USER_IDS=
# Day 30: приватный HTTP-сервис над локальной LLM (src/features/llm-service).
# Ключи доступа в формате name:secret через запятую. Пусто — сервис закрыт (401).
LLM_SERVICE_KEYS=
LLM_SERVICE_HOST=127.0.0.1
LLM_SERVICE_PORT=8088
# Необязательно: модель сервиса (по умолчанию LOCAL_LLM_MODEL).
LLM_SERVICE_MODEL=
# Лимиты: запросов/мин на ключ, токенов/мин на ключ, запросов/мин на IP.
LLM_SERVICE_RPM=20
LLM_SERVICE_TOKENS_PER_MIN=20000
LLM_SERVICE_IP_RPM=60
# Max context (gpt-tokenizer): граница входа (превышение — 413) и потолок выхода.
LLM_SERVICE_MAX_INPUT_TOKENS=4096
LLM_SERVICE_MAX_OUTPUT_TOKENS=1024
# Очередь к одному воркеру MLX: глубина и таймаут ожидания (мс).
LLM_SERVICE_QUEUE_DEPTH=4
LLM_SERVICE_QUEUE_WAIT_MS=15000
# Необязательно: температура по умолчанию (0..2).
LLM_SERVICE_TEMPERATURE=0.6
# Необязательно: JSONL-лог использования (по умолчанию ~/.ai-advent-challenge/llm-service/usage.jsonl).
LLM_SERVICE_USAGE_LOG=
# Необязательно: свой путь к HTML чат-страницы (по умолчанию рядом с бандлом).
LLM_SERVICE_CHAT_PAGE=
