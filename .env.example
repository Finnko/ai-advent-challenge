DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-flash
HUGGING_FACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Необязательно: путь к файлу БД агента (по умолчанию ~/.ai-advent-challenge/agent.sqlite)
AGENT_DB_PATH=
# Необязательно: папка отчётов research-MCP (по умолчанию ~/.ai-advent-challenge/reports)
REPORTS_DIR=
# Необязательно: RAG-эмбеддер (Day 21). Провайдер local — ONNX-модель на CPU без сети после загрузки.
RAG_EMBED_PROVIDER=local
RAG_EMBED_MODEL=Xenova/multilingual-e5-base
RAG_EMBED_DTYPE=q8
# Необязательно: реранкер второго этапа (Day 23). Локальный ONNX cross-encoder.
RAG_RERANK_MODEL=Xenova/bge-reranker-base
RAG_RERANK_DTYPE=q8
# Необязательно: порог отсечения нерелевантных результатов (0..1)
RAG_RERANK_THRESHOLD=0.5
# Необязательно: порог косинуса для режима «не знаю» в RAG-пайплайнах без реранка (0..1)
RAG_COSINE_THRESHOLD=0.35
# Необязательно: путь к БД индекса (по умолчанию ~/.ai-advent-challenge/rag.sqlite)
RAG_DB_PATH=
# Необязательно: каталог кеша ONNX-моделей (по умолчанию внутри node_modules/@huggingface/transformers)
RAG_EMBED_CACHE_DIR=
RAG_RERANK_CACHE_DIR=
# Необязательно: папка кеша статей Википедии (по умолчанию ~/.ai-advent-challenge/rag-corpus)
RAG_CORPUS_DIR=
# Необязательно: контакт в User-Agent для MediaWiki API (по умолчанию URL репозитория проекта)
RAG_WIKI_CONTACT=
# Необязательно: локальная LLM на MLX (Day 26). OpenAI-совместимый эндпоинт mlx_lm.server.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=mlx-community/Qwen3-8B-4bit
# Необязательно: модель именно для Telegram-квиза (Day 27). По умолчанию LOCAL_LLM_MODEL.
# mlx_lm.server должен быть запущен с этой же моделью.
QUIZ_LLM_MODEL=mlx-community/Qwen3-14B-4bit
# Необязательно: модель локальной генерации RAG-ответов (Day 28). По умолчанию 14B.
# mlx_lm.server должен быть запущен с этой же моделью.
RAG_LLM_MODEL=mlx-community/Qwen3-14B-4bit
# Обязательно для Telegram-квиза (Day 27). Токен от @BotFather.
TELEGRAM_BOT_TOKEN=
# Необязательно: список Telegram user id через запятую. Пусто — бот открыт для всех (dev).
TELEGRAM_ALLOWED_USER_IDS=
# Day 30: приватный HTTP-сервис над локальной LLM (src/features/llm-service).
# Ключи доступа в формате name:secret через запятую. Пусто — сервис закрыт (401).
LLM_SERVICE_KEYS=
LLM_SERVICE_HOST=127.0.0.1
LLM_SERVICE_PORT=8088
# Необязательно: модель сервиса (по умолчанию LOCAL_LLM_MODEL).
LLM_SERVICE_MODEL=
# Лимиты: запросов/мин на ключ, токенов/мин на ключ, запросов/мин на IP.
LLM_SERVICE_RPM=20
LLM_SERVICE_TOKENS_PER_MIN=20000
LLM_SERVICE_IP_RPM=60
# Max context (gpt-tokenizer): граница входа (превышение — 413) и потолок выхода.
LLM_SERVICE_MAX_INPUT_TOKENS=4096
LLM_SERVICE_MAX_OUTPUT_TOKENS=1024
# Очередь к одному воркеру MLX: глубина и таймаут ожидания (мс).
LLM_SERVICE_QUEUE_DEPTH=4
LLM_SERVICE_QUEUE_WAIT_MS=15000
# Необязательно: температура по умолчанию (0..2).
LLM_SERVICE_TEMPERATURE=0.6
# Необязательно: JSONL-лог использования (по умолчанию ~/.ai-advent-challenge/llm-service/usage.jsonl).
LLM_SERVICE_USAGE_LOG=
# Необязательно: свой путь к HTML чат-страницы (по умолчанию рядом с бандлом).
LLM_SERVICE_CHAT_PAGE=
# Day 31: ассистент разработчика (/dev-assistant). Корпус — доки проекта, читаются с диска.
# Необязательно: корень репозитория для корпуса и git-MCP (по умолчанию cwd).
DEV_ASSISTANT_REPO_DIR=
# Необязательно: путь к индексу ассистента (по умолчанию ~/.ai-advent-challenge/dev-assistant.sqlite).
DEV_ASSISTANT_DB_PATH=
# Необязательно: репозиторий для read-only git-MCP-сервера (по умолчанию DEV_ASSISTANT_REPO_DIR или cwd).
GIT_REPO_DIR=
# Day 34: файловый ассистент (npm run file-assistant) и его MCP-сервер.
# Необязательно: путь к сборке файлового MCP-сервера (по умолчанию dist или src).
DEV_ASSISTANT_MCP_FILES_ENTRY=
# Необязательно: БД прогонов и задач файлового ассистента (по умолчанию ~/.ai-advent-challenge/dev-assistant-runs.sqlite).
DEV_ASSISTANT_RUNS_DB_PATH=
# Необязательно: 'local' переключает генерацию файлового ассистента на локальную LLM через @lib/local-llm.server.
FILE_ASSISTANT_GENERATOR=
# Day 32: автопайплайн ревью PR (features/dev-assistant/cli/review.ts + GitHub Action).
# Заполняет workflow в CI; для локального прогона укажите базу и включите dry-run:
#   PR_BASE_SHA=<ref> PR_REVIEW_DRY_RUN=1 npm run review:pr
# База и head сравнения (SHA или ref). В CI приходят из workflow.
PR_BASE_SHA=
PR_HEAD_SHA=
# Номер PR и репозиторий owner/repo — нужны, чтобы публиковать комментарии.
PR_NUMBER=
GITHUB_REPOSITORY=
GITHUB_TOKEN=
# Необязательно: 'local' переключает генерацию на локальную LLM через @lib/local-llm.server.
PR_REVIEW_GENERATOR=
# Необязательно: '0' выключает второй этап ревью — судью, который отбирает подтверждённые находки.
PR_REVIEW_JUDGE=
# Необязательно: '1' — печатать ревью без публикации; '1' в PR_REVIEW_SKIP_TYPECHECK — без блока typecheck.
PR_REVIEW_DRY_RUN=
PR_REVIEW_SKIP_TYPECHECK=

# Day 35: авторевью студенческого проекта (src/features/auto-review).
# Необязательно: путь к файлу БД проверок (по умолчанию ~/.ai-advent-challenge/auto-review.sqlite).
AUTO_REVIEW_DB_PATH=
# Необязательно: максимальный размер загружаемого zip в байтах (по умолчанию 40 МиБ).
AUTO_REVIEW_MAX_UPLOAD_BYTES=
# Необязательно: таймауты прогона в миллисекундах (install / старт дев-сервера / весь Playwright).
AUTO_REVIEW_INSTALL_TIMEOUT_MS=
AUTO_REVIEW_SERVE_TIMEOUT_MS=
AUTO_REVIEW_TEST_TIMEOUT_MS=
# Необязательно: общий дедлайн ожидания прогона в CLI, мс (по умолчанию 1800000).
AUTO_REVIEW_RUN_TIMEOUT_MS=
# Необязательно: бюджет кода для оценки моделью в символах (по умолчанию 120000).
AUTO_REVIEW_CODE_BUDGET=
# Необязательно: потолок ответа модели при оценке и формулировке замечаний.
AUTO_REVIEW_JUDGE_MAX_TOKENS=
# Необязательно: браузеры набора через запятую (по умолчанию chromium,firefox).
AUTO_REVIEW_BROWSERS=

# Day 33: неофициальный помощник Ozon (/support).
SUPPORT_DB_PATH=
SUPPORT_CORPUS_DIR=
SUPPORT_FIXTURES_DIR=
SUPPORT_MCP_OZON_ENTRY=
SUPPORT_IP_PER_HOUR=30
SUPPORT_GLOBAL_PER_HOUR=60
SUPPORT_DAILY_MAX=200
SUPPORT_MAX_QUESTION_CHARS=800
SUPPORT_MAX_BODY_BYTES=4096
SUPPORT_TIMEOUT_MS=45000
SUPPORT_QUEUE_DEPTH=2
SUPPORT_QUEUE_WAIT_MS=15000
SUPPORT_LEXICAL_BOOST=0.03
SUPPORT_PUBLIC=0
SUPPORT_WARMUP=1
SUPPORT_GENERATOR=cloud
